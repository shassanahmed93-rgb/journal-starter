aws_region = "REPLACE_WITH_YOUR_AWS_REGION"

# Select an EKS Kubernetes version supported in that region.
cluster_version = "REPLACE_WITH_SUPPORTED_EKS_VERSION"

# Set stable client egress CIDRs. Avoid 0.0.0.0/0.
cluster_endpoint_public_access_cidrs = ["REPLACE_WITH_STATIC_EGRESS_CIDR/32"]

postgres_engine_version = "REPLACE_WITH_SUPPORTED_POSTGRES_VERSION"

# This must be a hostname in a public Route 53 hosted zone you own.
api_domain     = "REPLACE_WITH_DOMAIN_YOU_OWN"
route53_zone_id = "REPLACE_WITH_EXISTING_PUBLIC_HOSTED_ZONE_ID"

# Choose a model/deployment name available from your selected provider.
openai_model = "REPLACE_WITH_PROVIDER_MODEL"
alarm_notification_email = "REPLACE_WITH_ALERT_EMAIL"

# Change this when deploying a fork.
github_repository = "shassanahmed93-rgb/journal-starter"
