aws_region = "us-east-1"

# Set this to a currently supported EKS version in your region.
cluster_version = "REPLACE_WITH_SUPPORTED_EKS_VERSION"

# Use your current public egress IP as /32. Never use 0.0.0.0/0.
cluster_endpoint_public_access_cidrs = ["REPLACE_WITH_CURRENT_EGRESS_IP/32"]

postgres_engine_version = "REPLACE_WITH_SUPPORTED_POSTGRES_16_VERSION"
postgres_multi_az = false

# First apply: keep CloudFront disabled until the Kubernetes ALB exists.
create_cloudfront = false
cloudfront_origin_domain_name = ""

# Groq Responses API-compatible endpoint and model.
openai_base_url = "https://api.groq.com/openai/v1"
openai_model = "openai/gpt-oss-20b"

alarm_notification_email = "REPLACE_WITH_ALERT_EMAIL"
github_repository = "shassanahmed93-rgb/journal-starter"
